node_modules/
dist/
*.tsbuildinfo

# Persisted run state — live game data, not source.
# Leading slash matters: a bare `data/` also matches packages/data/, which
# would silently untrack that whole package's sources.
/data/
.DS_Store
.env
.env.local

# Never commit ROMs, saves, or save states. See the Legal section of PLAN.md.
*.gba
*.sav
*.ss[0-9]
*.srm
roms/
